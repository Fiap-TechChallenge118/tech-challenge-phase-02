# =============================================================================
# .env.example — Template de variáveis de ambiente
#
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env
#   3. NUNCA commite o .env — apenas o .env.example vai para o repositório
# =============================================================================


# =============================================================================
# PROJETO
# =============================================================================

# Nome do projeto (usado em logs e MLflow)
PROJECT_NAME=tech-challenge-02

# Ambiente de execução: development | staging | production
ENV=development

# Semente global para reproducibilidade (PyTorch, NumPy, Scikit-Learn, Python random)
RANDOM_SEED=42


# =============================================================================
# MLFLOW
# =============================================================================

# URI do servidor MLflow
# Sem servidor (padrão local): sqlite:///mlflow.db
# Com servidor rodando (docker compose): http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# Nome do experimento no MLflow
MLFLOW_EXPERIMENT_NAME=recommendation-system

# Nome do modelo registrado no Model Registry
MLFLOW_REGISTERED_MODEL_NAME=recommender-mlp

# Usuário e senha para MLflow com autenticação básica (opcional)
# MLFLOW_TRACKING_USERNAME=admin
# MLFLOW_TRACKING_PASSWORD=password


# =============================================================================
# DVC — Versionamento de Dados
# =============================================================================

# Tipo de remote DVC: local | s3 | gs | azure
DVC_REMOTE_TYPE=s3

# Caminho do remote DVC (configurado em .dvc/config como remote padrão "s3remote")
# Local:   /tmp/dvc-remote
# S3:      s3://meu-bucket/dvc-cache
# GCS:     gs://meu-bucket/dvc-cache
DVC_REMOTE_URL=s3://fiap-tc02-dvc-remote/dvc

# Credenciais AWS para o remote S3 (deixe em branco para usar o profile do AWS CLI)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1



# =============================================================================
# DADOS
# =============================================================================

# Caminho para o diretório raiz dos dados
DATA_DIR=data

# Caminho para dados brutos (input do pipeline)
DATA_RAW_DIR=data/raw

# Caminho para dados processados (output do pipeline)
DATA_PROCESSED_DIR=data/processed

# Dataset a ser utilizado: instacart | retailrocket | movielens
DATASET_NAME=instacart

# =============================================================================
# PRÉ-PROCESSAMENTO
# Estes valores são definidos em configs/config.yaml (data.strategy / data.n_negatives).
# Defina aqui apenas para sobrescrever o config em runtime (ex: CI, experimentos).
# =============================================================================

# Estratégia de pré-processamento via PreprocessorFactory
# Opções: interaction_pairs | user_item_matrix | aggregated_features
# PREPROCESSING_STRATEGY=interaction_pairs

# Número de negativos amostrados por par positivo (interaction_pairs)
# N_NEGATIVES=1


# =============================================================================
# MODELO — Hiperparâmetros MLP
# =============================================================================

# Dimensão dos embeddings de usuário e produto
EMBEDDING_DIM=64

# Camadas ocultas da MLP (separadas por vírgula)
HIDDEN_LAYERS=[256,128,64]

# Taxa de dropout
DROPOUT_RATE=0.3

# Taxa de aprendizado inicial
LEARNING_RATE=0.001

# Número máximo de épocas de treinamento
MAX_EPOCHS=50

# Tamanho do batch de treinamento
BATCH_SIZE=1024

# Paciência para early stopping (épocas sem melhora)
EARLY_STOPPING_PATIENCE=5

# Peso para classe positiva (desbalanceamento) — None para desativar
# POS_WEIGHT=10.0


# =============================================================================
# AVALIAÇÃO
# =============================================================================

# K para métricas Precision@K, Recall@K, NDCG@K
EVALUATION_K=10

# Proporção do dataset para validação
VALIDATION_SPLIT=0.1

# Proporção do dataset para teste
TEST_SPLIT=0.1


# =============================================================================
# LOGGING
# =============================================================================

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Formato de log: json | text
LOG_FORMAT=json
